## Required for signing in (JWT in httpOnly cookie)
CRM_SESSION_SECRET='YOUR_SECRET_HERE'
CRM_LOGIN_PASSWORD='YOUR_PASSWORD_HERE'

## Google Apps Script web app → keeps API key server-side only
CRM_APPS_SCRIPT_URL='YOUR_URL_HERE'
CRM_APPS_SCRIPT_API_KEY='YOUR_API_KEY_HERE'

## Archive tab “Unlock” PIN (readable in browser; still blocks casual deletes)
NEXT_PUBLIC_CRM_ARCHIVE_ADMIN_PASSWORD='YOUR_PASSWORD_HERE'
